# ===== Discord =====
# From https://discord.com/developers/applications -> Bot -> Reset Token
DISCORD_BOT_TOKEN="your-discord-bot-token"
# Optional: register the /song slash command to this guild only (instant,
# handy for dev). Leave unset to register globally (may take a bit to show up).
DISCORD_GUILD_ID=""

# ===== OpenAI =====
# From https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-your-openai-api-key"
# Optional: base URL for an OpenAI-compatible endpoint
# (e.g. https://openrouter.ai/api/v1, http://localhost:11434/v1, Azure deployment)
OPENAI_BASE_URL=""
# Optional: model to use for lyric generation
OPENAI_MODEL="gpt-4o-mini"

# ===== ComfyUI =====
# Required for Comfy Cloud; NOT needed for a local self-hosted instance
# (leave empty / unset when using COMFY_BASE_URL with the local proxy)
COMFY_API_KEY="comfyui-your-comfy-cloud-key"
# Required for self-hosted: URL of comfy-api-proxy (pip install comfy-api-proxy)
# which serves the API v2 in front of your ComfyUI on 127.0.0.1:8188.
# Leave unset to use Comfy Cloud instead.
COMFY_BASE_URL="http://127.0.0.1:8189"
# Path to your workflow exported in API format ("Save (API Format)" in ComfyUI)
COMFY_WORKFLOW_PATH="workflow.json"
# Node id of the text node that receives the style text
COMFY_STYLE_NODE_ID="1"
# Input/widget name of the style text field (default: text)
COMFY_STYLE_FIELD_NAME="text"
# Node id of the text node that receives the lyrics
COMFY_LYRICS_NODE_ID="2"
# Input/widget name of the lyrics text field (default: text)
COMFY_LYRICS_FIELD_NAME="text"
# Optional: node id for a seed input (random int generated each run)
COMFY_SEED_NODE_ID=""
# Input/widget name of the seed field (default: seed)
COMFY_SEED_FIELD_NAME="seed"
# Optional: node id of the output node (defaults to any output)
COMFY_OUTPUT_NODE_ID=""
# Optional: job timeout in ms (default 10 minutes)
COMFY_RUN_TIMEOUT_MS="600000"

# Where generated audio files are saved
OUTPUT_DIR="output"

# How long (minutes) to stay in the voice channel after the queue empties
# before disconnecting. Default: 10
VOICE_IDLE_MINUTES="10"

# Set to any truthy value to enable verbose debug logs
DEBUG=""
